<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup>
    <!-- NuGet Package Metadata -->
    <PackageId>EasyAppDev.Blazor.Store</PackageId>
    <Version>2.1.0</Version>
    <Authors>Mashrul Haque</Authors>
    <Company>EasyAppDev</Company>
    <Product>EasyAppDev.Blazor.Store</Product>
    <Description>Type-safe state management for Blazor using C# records. Includes async helpers, Redux DevTools integration, persistence, and granular selectors. Inspired by Zustand.</Description>
    <PackageTags>blazor;state-management;redux;zustand;devtools;reactive;solid;dependency-injection</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mashrulhaque/EasyAppDev.Blazor.Store</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mashrulhaque/EasyAppDev.Blazor.Store</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>
v2.1.0 - Phase 4: Advanced Features

New Features:
- Optimistic updates: UpdateOptimistic() and UpdateOptimisticWithConfirm() for instant UI feedback with automatic rollback
- Undo/Redo: IStoreHistory&lt;T&gt; with UndoAsync/RedoAsync, grouping, and exclusion filters
- Type-safe actions: IAction interface, IActionDispatcher&lt;T&gt;, reducer pattern with pattern matching
- Cross-tab sync: WithTabSync() middleware for BroadcastChannel-based state synchronization (WebAssembly)
- Source generators: [Store] attribute generates SetX, UpdateX methods and optional actions

New Packages:
- EasyAppDev.Blazor.Store.Generators: Source generators for reducing boilerplate

Usage Examples:
- Optimistic: await store.UpdateOptimistic(s =&gt; s.AddItem(item), () =&gt; api.AddAsync())
- Undo/Redo: builder.WithHistory(out history); await history.UndoAsync()
- Actions: dispatcher.Register&lt;Increment&gt;((s, a) =&gt; s with { Count = s.Count + 1 })
- TabSync: store.WithTabSync(sp, opts =&gt; opts.Channel("cart"))

v2.0.0 - Phase 3: Core Enhancements
(See previous release notes)
    </PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EasyAppDev.Blazor.Store.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
    <PackageReference Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Exclude Diagnostics Razor components from Release builds (DEBUG-only feature) -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Content Remove="Diagnostics\Components\*.razor" />
    <Compile Remove="Diagnostics\Components\*.razor" />
  </ItemGroup>

</Project>
