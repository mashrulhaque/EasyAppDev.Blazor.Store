@page "/async-data-demo"
@inherits StoreComponent<AsyncDataDemoState>
@using EasyAppDev.Blazor.Store.Sample.State
@using EasyAppDev.Blazor.Store.AsyncActions
@inject ReqResApi Api

<PageTitle>AsyncData Demo</PageTitle>

<div class="container mt-4">
    <h1>AsyncData&lt;T&gt; Demo</h1>
    <p class="lead">
        Simplified async state management - reduce 20+ lines of boilerplate to a single property!
    </p>

    <div class="alert alert-success mb-4">
        <strong>Real API!</strong> This demo uses <a href="https://jsonplaceholder.typicode.com" target="_blank" class="alert-link">JSONPlaceholder</a> -
        a free REST API with real user data. Click buttons to load different users.
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">User Profile</h5>
                    <div class="btn-group btn-group-sm">
                        @for (int i = 1; i <= 6; i++)
                        {
                            var userId = i;
                            <button class="btn @(State.CurrentUserId == userId ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => LoadUser(userId)"
                                    disabled="@State.User.IsLoading">
                                @userId
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (State.User.IsNotAsked)
                    {
                        <div class="text-center py-5">
                            <svg class="mb-3" width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                            </svg>
                            <p class="text-muted">Click a number above or "Load User" to fetch a profile from JSONPlaceholder API</p>
                        </div>
                    }
                    else if (State.User.IsLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <p class="mt-3">Loading user profile from JSONPlaceholder API...</p>
                        </div>
                    }
                    else if (State.User.HasError)
                    {
                        <div class="alert alert-danger" role="alert">
                            <h5 class="alert-heading">Error Loading Profile</h5>
                            <p class="mb-3">@State.User.Error</p>
                            <button class="btn btn-danger btn-sm" @onclick="() => LoadUser(State.CurrentUserId)">
                                Retry
                            </button>
                        </div>
                    }
                    else if (State.User.HasData)
                    {
                        <div class="user-profile position-relative">
                            @if (State.User.IsRefetching)
                            {
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center"
                                     style="background: rgba(255,255,255,0.8); z-index: 10;">
                                    <div class="text-center">
                                        <div class="spinner-border text-info" role="status">
                                            <span class="visually-hidden">Refreshing...</span>
                                        </div>
                                        <p class="mt-2 mb-0 text-info fw-bold">Refreshing...</p>
                                    </div>
                                </div>
                            }
                            <div class="text-center mb-4">
                                <img src="@State.User.Data!.Avatar" alt="@State.User.Data.Name"
                                     class="rounded-circle" width="128" height="128" />
                            </div>

                            <h4 class="text-center">@State.User.Data!.Name</h4>

                            <div class="mb-3">
                                <strong>Email:</strong> @State.User.Data.Email
                            </div>

                            <div class="mb-3">
                                <strong>Bio:</strong>
                                <p class="mb-0">@State.User.Data.Bio</p>
                            </div>

                            <p class="text-muted text-center">
                                <small>Loaded at @State.User.Data.LoadedAt.ToString("h:mm:ss tt")</small>
                            </p>
                        </div>
                    }
                </div>
            </div>

            <div class="mt-3 d-flex gap-2 flex-wrap">
                <button class="btn btn-primary" @onclick="() => LoadUser(State.CurrentUserId)" disabled="@State.User.IsFetching">
                    Load User @State.CurrentUserId
                </button>
                <button class="btn btn-info" @onclick="BackgroundRefresh" disabled="@(!State.User.HasData || State.User.IsFetching)">
                    Background Refresh
                </button>
                <button class="btn btn-warning" @onclick="SimulateError" disabled="@State.User.IsFetching">
                    Simulate Error (User 999)
                </button>
                <button class="btn btn-secondary" @onclick="Reset">
                    Reset
                </button>
            </div>

            <div class="alert alert-info mt-3" role="alert">
                <strong>Stale-While-Revalidate:</strong> Click "Background Refresh" after loading a user.
                The current profile stays visible while new data loads in the background.
                Watch <code>IsRefetching</code> turn true!
            </div>

            <div class="card mt-4">
                <div class="card-header">
                    <h5>Code Comparison</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-danger">Traditional Approach (20+ lines):</h6>
                            <pre class="bg-light p-2 small"><code>public record UserState(
    User? User = null,
    bool IsLoading = false,
    string? Error = null)
{
    public UserState StartLoading() =>
        this with { IsLoading = true };

    public UserState LoadSuccess(User u) =>
        this with {
            User = u,
            IsLoading = false
        };

    public UserState LoadFailure(string e) =>
        this with {
            IsLoading = false,
            Error = e
        };
}</code></pre>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-success">AsyncData Approach (1 property!):</h6>
                            <pre class="bg-light p-2 small"><code>public record UserState(
    AsyncData&lt;User&gt; User)
{
    public static UserState Initial =>
        new(AsyncData&lt;User&gt;.NotAsked());
}

// Usage:
State.User.IsNotAsked
State.User.IsLoading
State.User.HasData
State.User.HasError
State.User.Data
State.User.Error</code></pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">State Info</h5>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>IsNotAsked</dt>
                        <dd>
                            <span class="badge @(State.User.IsNotAsked ? "bg-success" : "bg-secondary")">
                                @State.User.IsNotAsked
                            </span>
                        </dd>

                        <dt>IsLoading</dt>
                        <dd>
                            <span class="badge @(State.User.IsLoading ? "bg-primary" : "bg-secondary")">
                                @State.User.IsLoading
                            </span>
                            <small class="text-muted d-block">Initial load only</small>
                        </dd>

                        <dt>IsFetching</dt>
                        <dd>
                            <span class="badge @(State.User.IsFetching ? "bg-info" : "bg-secondary")">
                                @State.User.IsFetching
                            </span>
                            <small class="text-muted d-block">Any fetch (initial or refetch)</small>
                        </dd>

                        <dt>IsRefetching</dt>
                        <dd>
                            <span class="badge @(State.User.IsRefetching ? "bg-warning" : "bg-secondary")">
                                @State.User.IsRefetching
                            </span>
                            <small class="text-muted d-block">HasData + IsFetching</small>
                        </dd>

                        <dt>HasData</dt>
                        <dd>
                            <span class="badge @(State.User.HasData ? "bg-success" : "bg-secondary")">
                                @State.User.HasData
                            </span>
                        </dd>

                        <dt>HasError</dt>
                        <dd>
                            <span class="badge @(State.User.HasError ? "bg-danger" : "bg-secondary")">
                                @State.User.HasError
                            </span>
                        </dd>

                        <dt>Current User ID</dt>
                        <dd>
                            <span class="badge bg-dark">@State.CurrentUserId</span>
                        </dd>
                    </dl>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Benefits</h5>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li><strong>-95% code</strong> (20+ lines to 1 property)</li>
                        <li><strong>Type-safe</strong> state checking</li>
                        <li><strong>No impossible states</strong></li>
                        <li><strong>Consistent pattern</strong> across app</li>
                        <li><strong>Clear transitions</strong></li>
                    </ul>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">State Transitions</h5>
                </div>
                <div class="card-body small">
                    <pre class="bg-light p-2 mb-0"><code>// Start loading (clears data)
Update(s => s with {
    User = s.User.ToLoading()
});

// Background refresh (keeps data)
Update(s => s with {
    User = s.User.ToLoadingPreserved()
});

// Success
Update(s => s with {
    User = AsyncData&lt;T&gt;.Success(data)
});

// Failure
Update(s => s with {
    User = AsyncData&lt;T&gt;.Failure(error)
});

// Reset
Update(s => s with {
    User = AsyncData&lt;T&gt;.NotAsked()
});</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    async Task LoadUser(int userId)
    {
        // Update current user ID and transition to Loading state
        Update(s => s with { CurrentUserId = userId, User = s.User.ToLoading() });

        try
        {
            // Call real API
            var user = await Api.GetUserAsync(userId);

            if (user == null)
            {
                Update(s => s with { User = AsyncData<UserProfileData>.Failure($"User {userId} not found") });
            }
            else
            {
                var profileData = new UserProfileData(
                    Id: user.Id,
                    Name: user.Name,
                    Email: user.Email,
                    Avatar: user.AvatarUrl,
                    Bio: user.Bio,
                    LoadedAt: DateTime.Now
                );
                Update(s => s with { User = AsyncData<UserProfileData>.Success(profileData) });
            }
        }
        catch (Exception ex)
        {
            Update(s => s with { User = AsyncData<UserProfileData>.Failure(ex.Message) });
        }
    }

    async Task BackgroundRefresh()
    {
        // Use ToLoadingPreserved() - keeps existing data visible while refetching
        // This enables the "stale-while-revalidate" pattern
        Update(s => s with { User = s.User.ToLoadingPreserved() });

        try
        {
            // Simulate network delay to see the overlay
            await Task.Delay(1500);

            var user = await Api.GetUserAsync(State.CurrentUserId);

            if (user != null)
            {
                var profileData = new UserProfileData(
                    Id: user.Id,
                    Name: user.Name,
                    Email: user.Email,
                    Avatar: user.AvatarUrl,
                    Bio: user.Bio,
                    LoadedAt: DateTime.Now
                );
                Update(s => s with { User = AsyncData<UserProfileData>.Success(profileData) });
            }
        }
        catch (Exception ex)
        {
            Update(s => s with { User = AsyncData<UserProfileData>.Failure(ex.Message) });
        }
    }

    async Task SimulateError()
    {
        // Try to load invalid user (will return null from API)
        Update(s => s with { CurrentUserId = 999, User = s.User.ToLoading() });

        try
        {
            var user = await Api.GetUserAsync(999);

            if (user == null)
            {
                Update(s => s with {
                    User = AsyncData<UserProfileData>.Failure("User 999 not found. Server returned 404 Not Found.")
                });
            }
        }
        catch (Exception ex)
        {
            Update(s => s with { User = AsyncData<UserProfileData>.Failure(ex.Message) });
        }
    }

    void Reset()
    {
        Update(s => s with { CurrentUserId = 1, User = AsyncData<UserProfileData>.NotAsked() });
    }
}
