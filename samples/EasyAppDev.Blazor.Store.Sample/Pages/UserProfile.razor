@page "/profile"
@using EasyAppDev.Blazor.Store.Sample.State
@inject ReqResApi Api
@inherits StoreComponent<UserProfileState>

<PageTitle>User Profile</PageTitle>

<div class="container mt-4">
    <h1>User Profile</h1>
    <p class="lead">Demonstrates <strong>async actions</strong> and <strong>loading states</strong></p>

    <div class="alert alert-success mb-4">
        <strong>Real API!</strong> This demo uses <a href="https://jsonplaceholder.typicode.com" target="_blank" class="alert-link">JSONPlaceholder</a> -
        a free REST API that provides real user data. Try loading different users (1-10).
    </div>

    <div class="alert alert-info">
        <h5>What This Demo Shows:</h5>
        <ul class="mb-0">
            <li>Async state updates with <code>UpdateAsync</code></li>
            <li>Loading states (IsLoading, Error handling)</li>
            <li>Real API calls to JSONPlaceholder</li>
            <li>UI feedback during async operations</li>
        </ul>
    </div>

    @if (State.IsLoading)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5>Loading user profile...</h5>
                <p class="text-muted">Fetching from JSONPlaceholder API...</p>
            </div>
        </div>
    }
    else if (State.Error != null)
    {
        <div class="alert alert-danger">
            <h5>Error Loading Profile</h5>
            <p class="mb-0">@State.Error</p>
            <button class="btn btn-danger btn-sm mt-2" @onclick="@(() => Update(s => s.Clear()))">
                Clear Error
            </button>
        </div>
    }
    else if (State.User == null)
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <h4>No profile loaded</h4>
                <p class="text-muted">Load a user profile to get started (users 1-12 are available)</p>
                <div class="mt-3">
                    <h5>Select a user:</h5>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        @for (int i = 1; i <= 12; i++)
                        {
                            var userId = i;
                            <button class="btn btn-outline-primary" @onclick="@(() => LoadUser(userId))">
                                User @userId
                            </button>
                        }
                    </div>
                    <div class="mt-3">
                        <button class="btn btn-outline-danger" @onclick="@(() => LoadUser(999))">
                            Invalid User (Error Demo)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-body text-center">
                        <img src="@State.User.AvatarUrl" alt="@State.User.Name" class="rounded-circle mb-3" width="150" height="150" />
                        <h5 class="card-title">@State.User.Name</h5>
                        <p class="text-muted">@State.User.Email</p>
                        @if (State.LastUpdated.HasValue)
                        {
                            <small class="text-muted">
                                Last updated: @State.LastUpdated.Value.ToString("h:mm:ss tt")
                            </small>
                        }
                    </div>
                </div>

                <div class="card mt-3">
                    <div class="card-header">
                        <h6 class="mb-0">Quick Load</h6>
                    </div>
                    <div class="card-body">
                        <div class="d-flex gap-1 flex-wrap">
                            @for (int i = 1; i <= 12; i++)
                            {
                                var userId = i;
                                <button class="btn btn-sm @(State.User.Id == userId ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="@(() => LoadUser(userId))"
                                        disabled="@State.IsLoading">
                                    @userId
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card">
                    <div class="card-header">
                        <h5>Edit Profile</h5>
                        <small class="text-muted">Changes are stored in local state (not sent to server)</small>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Name</label>
                            <input type="text"
                                   class="form-control"
                                   value="@State.User.Name"
                                   @onchange="@((e) => Update(s => s.UpdateName(e.Value?.ToString() ?? "")))" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email"
                                   class="form-control"
                                   value="@State.User.Email"
                                   @onchange="@((e) => Update(s => s.UpdateEmail(e.Value?.ToString() ?? "")))" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Bio</label>
                            <textarea class="form-control"
                                      rows="4"
                                      @onchange="@((e) => Update(s => s.UpdateBio(e.Value?.ToString() ?? "")))">@State.User.Bio</textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3 d-flex gap-2">
            @{
                var nextUserId = State.User.Id < 12 ? State.User.Id + 1 : 1;
            }
            <button class="btn btn-primary" @onclick="@(() => LoadUser(nextUserId))" disabled="@State.IsLoading">
                Load Next User (@nextUserId)
            </button>
            <button class="btn btn-secondary" @onclick="@(() => Update(s => s.Clear()))">
                Clear Profile
            </button>
        </div>
    }

    <div class="card mt-4">
        <div class="card-header">
            <h5>Code Example</h5>
        </div>
        <div class="card-body">
            <h6>State Definition with Loading States:</h6>
            <pre class="bg-light p-3"><code>public record UserProfileState(
    UserProfile? User = null,
    bool IsLoading = false,
    string? Error = null,
    DateTime? LastUpdated = null)
{
    public UserProfileState StartLoading() => this with
    {
        IsLoading = true,
        Error = null
    };

    public UserProfileState LoadSuccess(UserProfile user) => this with
    {
        User = user,
        IsLoading = false,
        LastUpdated = DateTime.Now
    };

    public UserProfileState LoadFailure(string error) => this with
    {
        IsLoading = false,
        Error = error
    };
}</code></pre>

            <h6 class="mt-3">Component with Real API Calls:</h6>
            <pre class="bg-light p-3"><code>@@inject ReqResApi Api
@@inherits StoreComponent&lt;UserProfileState&gt;

private async Task LoadUser(int userId)
{
    // Set loading state
    Update(s => s.StartLoading());

    try
    {
        // Call real API
        var user = await Api.GetUserAsync(userId);

        if (user == null)
            Update(s => s.LoadFailure("User not found"));
        else
            Update(s => s.LoadSuccess(user));
    }
    catch (Exception ex)
    {
        Update(s => s.LoadFailure(ex.Message));
    }
}</code></pre>

            <h6 class="mt-3">Key Principles:</h6>
            <ul>
                <li>Use dedicated loading/error state properties</li>
                <li>Handle loading state -> API call -> success/error pattern</li>
                <li>Keep async logic in components, state methods pure</li>
                <li>Inject API services for real data fetching</li>
                <li>Always handle errors gracefully</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private async Task LoadUser(int userId)
    {
        Update(s => s.StartLoading());

        try
        {
            var user = await Api.GetUserAsync(userId);

            if (user == null)
            {
                Update(s => s.LoadFailure($"User {userId} not found. Try a number between 1-12."));
            }
            else
            {
                Update(s => s.LoadSuccess(user));
            }
        }
        catch (Exception ex)
        {
            Update(s => s.LoadFailure(ex.Message));
        }
    }
}
