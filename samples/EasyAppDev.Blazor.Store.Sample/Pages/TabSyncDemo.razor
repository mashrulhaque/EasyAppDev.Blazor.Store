@page "/tab-sync-demo"
@inherits StoreComponent<TabSyncDemoState>

<PageTitle>Cross-Tab Sync</PageTitle>

<div class="container mt-4">
    <h1>Cross-Tab Sync</h1>
    <p class="lead">
        Real-time state synchronization across browser tabs using BroadcastChannel API.
    </p>

    <div class="alert alert-info">
        <strong>Try it!</strong> Open this page in multiple browser tabs. Messages will sync in real-time across all tabs.
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Chat Demo</h5>
                    <span class="badge bg-success">
                        @State.OnlineCount tab(s) open
                    </span>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="d-flex align-items-center mb-2">
                            <span class="badge bg-primary me-2">@State.CurrentUser</span>
                            <small class="text-muted">Your ID for this tab</small>
                        </div>
                    </div>

                    <div class="border rounded p-3 mb-3" style="height: 300px; overflow-y: auto;" @ref="chatContainer">
                        @if (State.Messages.Any())
                        {
                            @foreach (var msg in State.Messages)
                            {
                                var isOwn = msg.User == State.CurrentUser;
                                <div class="mb-2 @(isOwn ? "text-end" : "")">
                                    <div class="d-inline-block p-2 rounded @(isOwn ? "bg-primary text-white" : "bg-light")"
                                         style="max-width: 70%;">
                                        <div class="small @(isOwn ? "text-white-50" : "text-muted")">
                                            @msg.User - @msg.Timestamp.ToString("HH:mm:ss")
                                        </div>
                                        <div>@msg.Text</div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted text-center">No messages yet. Type something below!</p>
                        }
                    </div>

                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Type a message..."
                               @bind="newMessage" @bind:event="oninput"
                               @onkeyup="HandleKeyUp" />
                        <button class="btn btn-primary" @onclick="SendMessage"
                                disabled="@string.IsNullOrWhiteSpace(newMessage)">
                            Send
                        </button>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-outline-danger btn-sm" @onclick="ClearChat">
                            Clear All Messages
                        </button>
                    </div>
                </div>
                <div class="card-footer text-muted small">
                    Last sync: @State.LastSync.ToString("HH:mm:ss.fff")
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">How It Works</h5>
                </div>
                <div class="card-body small">
                    <p>
                        Uses the <strong>BroadcastChannel API</strong> to sync state across browser tabs.
                    </p>

                    <h6>Features:</h6>
                    <ul>
                        <li>Real-time synchronization</li>
                        <li>Debounce support for rapid updates</li>
                        <li>Action filtering (include/exclude)</li>
                        <li>HMAC message signing for security</li>
                    </ul>

                    <h6 class="mt-3">Setup:</h6>
                    <pre class="bg-light p-2"><code>builder.Services.AddStore(
  new ChatState(),
  (store, sp) => store
    .WithTabSync(sp, opts => opts
      .Channel("chat")
      .EnableMessageSigning()
      .ExcludeActions("LOCAL"))
);</code></pre>

                    <h6 class="mt-3">Architecture:</h6>
                    <div class="bg-light p-2 text-center small">
                        <p class="mb-1">Tab 1 updates state</p>
                        <p class="mb-1">↓</p>
                        <p class="mb-1">TabSyncMiddleware broadcasts</p>
                        <p class="mb-1">↓</p>
                        <p class="mb-1">Tab 2 receives update</p>
                        <p class="mb-1">↓</p>
                        <p class="mb-0">Both tabs show same state!</p>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Security Options</h5>
                </div>
                <div class="card-body small">
                    <ul>
                        <li><strong>Message Signing</strong>: HMAC-SHA256 prevents tampering</li>
                        <li><strong>Timestamp Validation</strong>: Prevents replay attacks</li>
                        <li><strong>Max Message Age</strong>: Reject old messages</li>
                    </ul>
                    <pre class="bg-light p-2"><code>.WithTabSync(sp, opts => opts
  .EnableMessageSigning()
  .WithSigningKey(customKey))</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string newMessage = "";
    private ElementReference chatContainer;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(newMessage))
        {
            await SendMessage();
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;

        var text = newMessage;
        newMessage = "";

        await Update(s => s.AddMessage(text), "SEND_MESSAGE");
    }

    private async Task ClearChat()
    {
        await Update(s => s.ClearMessages(), "CLEAR_MESSAGES");
    }
}
