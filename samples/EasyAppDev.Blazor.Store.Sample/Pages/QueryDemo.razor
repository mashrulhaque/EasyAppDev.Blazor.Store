@page "/query-demo"
@using EasyAppDev.Blazor.Store.Query
@using EasyAppDev.Blazor.Store.Sample.State
@inject JsonPlaceholderApi Api
@inherits QueryComponent

<PageTitle>Query System</PageTitle>

<div class="container mt-4">
    <h1>Query System</h1>
    <p class="lead">
        TanStack Query-inspired data fetching with caching, background refresh, and loading states.
    </p>

    <div class="alert alert-success mb-4">
        <strong>Real API!</strong> This demo uses <a href="https://jsonplaceholder.typicode.com" target="_blank" class="alert-link">JSONPlaceholder</a> -
        a free REST API for testing and prototyping. All data is fetched from the real API.
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Users Query</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3 d-flex gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick="RefetchUsers">
                            Refetch
                        </button>
                        <button class="btn btn-outline-secondary btn-sm" @onclick="InvalidateUsers">
                            Invalidate Cache
                        </button>
                    </div>

                    @if (usersQuery?.IsLoading == true)
                    {
                        <div class="d-flex align-items-center">
                            <div class="spinner-border spinner-border-sm me-2"></div>
                            <span>Loading users from JSONPlaceholder API...</span>
                        </div>
                    }
                    else if (usersQuery?.IsError == true)
                    {
                        <div class="alert alert-danger">
                            Error: @usersQuery.Error?.Message
                        </div>
                    }
                    else if (usersQuery?.IsSuccess == true && usersQuery.Data != null)
                    {
                        <div class="list-group">
                            @foreach (var user in usersQuery.Data)
                            {
                                <button class="list-group-item list-group-item-action @(selectedUserId == user.Id ? "active" : "")"
                                        @onclick="() => SelectUser(user.Id)">
                                    <div class="d-flex align-items-center">
                                        <img src="@user.Avatar" alt="@user.Name" class="rounded-circle me-3" width="40" height="40" />
                                        <div class="flex-grow-1">
                                            <div class="d-flex justify-content-between">
                                                <strong>@user.Name</strong>
                                                <small class="@(selectedUserId == user.Id ? "" : "text-muted")">@@@user.Username</small>
                                            </div>
                                            <small class="@(selectedUserId == user.Id ? "" : "text-muted")">@user.Email</small>
                                            @if (user.Company != null)
                                            {
                                                <br />
                                                <small class="@(selectedUserId == user.Id ? "" : "text-muted")">@user.Company.Name</small>
                                            }
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }

                    @if (usersQuery != null)
                    {
                        <div class="mt-2 text-muted small">
                            Status: @usersQuery.Status |
                            Fetching: @usersQuery.IsFetching |
                            Stale: @usersQuery.IsStale |
                            Updated: @(usersQuery.DataUpdatedAt?.ToString("HH:mm:ss") ?? "Never")
                        </div>
                    }
                </div>
            </div>

            @if (selectedUserId > 0)
            {
                @if (selectedUser != null)
                {
                    <div class="card mb-4">
                        <div class="card-header">
                            <h5 class="mb-0">User Details</h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Name:</strong> @selectedUser.Name</p>
                                    <p><strong>Username:</strong> @@@selectedUser.Username</p>
                                    <p><strong>Email:</strong> @selectedUser.Email</p>
                                    <p><strong>Phone:</strong> @selectedUser.Phone</p>
                                    <p><strong>Website:</strong> @selectedUser.Website</p>
                                </div>
                                <div class="col-md-6">
                                    @if (selectedUser.Address != null)
                                    {
                                        <p><strong>Address:</strong></p>
                                        <p class="ps-3">
                                            @selectedUser.Address.Street, @selectedUser.Address.Suite<br />
                                            @selectedUser.Address.City @selectedUser.Address.Zipcode
                                        </p>
                                    }
                                    @if (selectedUser.Company != null)
                                    {
                                        <p><strong>Company:</strong> @selectedUser.Company.Name</p>
                                        <p class="small text-muted ps-3">"@selectedUser.Company.CatchPhrase"</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Posts by @(selectedUser?.Name ?? "Selected User")</h5>
                        @if (postsQuery?.IsFetching == true)
                        {
                            <div class="spinner-border spinner-border-sm"></div>
                        }
                    </div>
                    <div class="card-body">
                        @if (postsQuery?.IsLoading == true)
                        {
                            <div class="text-center py-4">
                                <div class="spinner-border"></div>
                            </div>
                        }
                        else if (postsQuery?.IsError == true)
                        {
                            <div class="alert alert-danger">@postsQuery.Error?.Message</div>
                        }
                        else if (postsQuery?.Data != null)
                        {
                            @if (postsQuery.Data.Any())
                            {
                                @foreach (var post in postsQuery.Data)
                                {
                                    <div class="card mb-2">
                                        <div class="card-body">
                                            <h6 class="card-title">@post.Title</h6>
                                            <p class="card-text small text-muted">@post.Body</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="text-muted">No posts found for this user.</p>
                            }
                        }
                    </div>
                </div>

                <div class="card mb-4">
                    <div class="card-header">
                        <h5 class="mb-0">Create New Post (Mutation)</h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <input type="text" class="form-control" placeholder="Post title..."
                                   @bind="newPostTitle" />
                        </div>
                        <div class="mb-3">
                            <textarea class="form-control" rows="3" placeholder="Post body..."
                                      @bind="newPostBody"></textarea>
                        </div>
                        <button class="btn btn-primary"
                                @onclick="CreatePost"
                                disabled="@(createPostMutation?.IsLoading == true || string.IsNullOrWhiteSpace(newPostTitle))">
                            @if (createPostMutation?.IsLoading == true)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                                <span>Creating...</span>
                            }
                            else
                            {
                                <span>Create Post</span>
                            }
                        </button>

                        @if (createPostMutation?.IsSuccess == true)
                        {
                            <div class="alert alert-success mt-3">
                                Post created successfully! ID: @createPostMutation.Data?.Id
                                <br />
                                <small class="text-muted">Note: JSONPlaceholder simulates POST requests - data isn't actually persisted on the server.</small>
                            </div>
                        }
                        @if (createPostMutation?.IsError == true)
                        {
                            <div class="alert alert-danger mt-3">
                                Error: @createPostMutation.Error?.Message
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">How It Works</h5>
                </div>
                <div class="card-body small">
                    <h6>API Used:</h6>
                    <p>
                        <a href="https://jsonplaceholder.typicode.com" target="_blank">JSONPlaceholder</a> -
                        Free REST API with Users, Posts, Comments, and more.
                    </p>

                    <h6 class="mt-3">Query Features:</h6>
                    <ul>
                        <li><strong>Caching</strong>: Data cached until stale</li>
                        <li><strong>Background Refresh</strong>: Updates silently</li>
                        <li><strong>Loading States</strong>: IsLoading, IsFetching</li>
                        <li><strong>Error Handling</strong>: Built-in retry</li>
                        <li><strong>Cache Invalidation</strong>: Manual or automatic</li>
                    </ul>

                    <h6 class="mt-3">Registration:</h6>
                    <pre class="bg-light p-2"><code>builder.Services
  .AddQueryClient();</code></pre>

                    <h6 class="mt-3">Query Usage:</h6>
                    <pre class="bg-light p-2"><code>var query = UseQuery(
  "users",
  ct => api.GetUsersAsync(ct)
);

@@if (query.IsLoading)
@@if (query.IsError)
@@if (query.IsSuccess)</code></pre>

                    <h6 class="mt-3">Mutation Usage:</h6>
                    <pre class="bg-light p-2"><code>var mutation = UseMutation(
  req => api.CreateAsync(req)
);

await mutation.MutateAsync(data);

// Invalidate cache after mutation
QueryClient.InvalidateQueries("posts-*");</code></pre>

                    <h6 class="mt-3">Key Points:</h6>
                    <ul>
                        <li>Queries auto-fetch on mount</li>
                        <li>Data cached by query key</li>
                        <li>Mutations for write operations</li>
                        <li>Invalidate to refetch related queries</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private Query<List<QueryUser>>? usersQuery;
    private Query<List<QueryPost>>? postsQuery;
    private Mutation<QueryPost?, CreatePostRequest>? createPostMutation;

    private int selectedUserId;
    private QueryUser? selectedUser;
    private string newPostTitle = "";
    private string newPostBody = "";

    protected override void OnInitialized()
    {
        usersQuery = UseQuery("users", async ct => await Api.GetUsersAsync(ct));

        createPostMutation = UseMutation<QueryPost?, CreatePostRequest>(
            async req => await Api.CreatePostAsync(req));
    }

    private async Task RefetchUsers()
    {
        if (usersQuery != null)
        {
            await usersQuery.RefetchAsync();
        }
    }

    private void InvalidateUsers()
    {
        usersQuery?.Invalidate();
    }

    private void SelectUser(int userId)
    {
        selectedUserId = userId;
        selectedUser = usersQuery?.Data?.FirstOrDefault(u => u.Id == userId);

        postsQuery = UseQuery($"posts-{userId}", async ct => await Api.GetPostsByUserAsync(userId, ct));
    }

    private async Task CreatePost()
    {
        if (string.IsNullOrWhiteSpace(newPostTitle) || createPostMutation == null) return;

        var request = new CreatePostRequest(selectedUserId, newPostTitle, newPostBody);
        await createPostMutation.MutateAsync(request);

        if (createPostMutation.IsSuccess)
        {
            newPostTitle = "";
            newPostBody = "";
            // Invalidate posts cache to refetch
            QueryClient.InvalidateQueries($"posts-{selectedUserId}");
            if (postsQuery != null)
            {
                await postsQuery.RefetchAsync();
            }
        }
    }
}
