@page "/"

<PageTitle>Home</PageTitle>

<div class="container mt-4">
    <div class="text-center mb-5">
        <h1 class="display-4">EasyAppDev.Blazor.Store</h1>
        <p class="lead">Type-safe state management for Blazor using C# records</p>
        <p class="text-muted">Inspired by Zustand | Built for C# developers</p>
    </div>

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="alert alert-primary">
                <h4>Welcome to the Interactive Demo!</h4>
                <p class="mb-0">
                    This sample application demonstrates all features of EasyAppDev.Blazor.Store.
                    Each page shows a different aspect of the library with live examples and code samples.
                </p>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Why This Library?</h5>
                    <ul class="card-text small">
                        <li><strong>Zero boilerplate</strong> - No actions, reducers, or dispatchers</li>
                        <li><strong>Type-safe</strong> - Full C# type safety with IntelliSense</li>
                        <li><strong>Immutable</strong> - Records with <code>with</code> expressions</li>
                        <li><strong>Automatic updates</strong> - Components re-render on state changes</li>
                        <li><strong>Redux DevTools</strong> - Time-travel debugging</li>
                        <li><strong>Persistence</strong> - LocalStorage built-in</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Core Concepts</h5>
                    <ul class="card-text small">
                        <li><strong>State:</strong> Immutable C# records</li>
                        <li><strong>Store:</strong> Holds and manages state</li>
                        <li><strong>Components:</strong> Subscribe via base classes</li>
                        <li><strong>Updates:</strong> Pure transformation methods</li>
                        <li><strong>Selectors:</strong> Granular re-render control</li>
                        <li><strong>Middleware:</strong> Logging, DevTools, Persistence</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Quick Start</h5>
                    <pre class="card-text small"><code>// 1. Define state
public record CounterState(int Count)
{
    public CounterState Increment()
        => this with { Count = Count + 1 };
}

// 2. Register store
builder.Services.AddStore(
    new CounterState(0));

// 3. Use in component
@@inherits StoreComponent&lt;CounterState&gt;
@@State.Count</code></pre>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mb-4">Core Features</h2>

    <div class="row g-4 mb-5">
        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Counter (Basic + DevTools)</h5>
                    <p class="card-text small">
                        The classic counter example demonstrating basic state management and Redux DevTools integration.
                    </p>
                    <a href="/counter" class="btn btn-outline-primary btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Todo List (Immutable Collections)</h5>
                    <p class="card-text small">
                        Working with ImmutableList operations: Add, Remove, Filter, and complex state transformations.
                    </p>
                    <a href="/todos" class="btn btn-outline-primary btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Shopping Cart (Persistence)</h5>
                    <p class="card-text small">
                        Automatic state persistence with LocalStorage. Cart survives page refreshes and browser restarts.
                    </p>
                    <a href="/cart" class="btn btn-outline-primary btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">Theme Settings (Selectors)</h5>
                    <p class="card-text small">
                        Performance optimization with SelectorStoreComponent. Only re-render when selected state changes.
                    </p>
                    <a href="/theme" class="btn btn-outline-primary btn-sm">View Demo</a>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mb-4">Async Helpers</h2>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title">AsyncData&lt;T&gt;</h6>
                    <p class="card-text small">Loading states made simple</p>
                    <a href="/async-data-demo" class="btn btn-outline-secondary btn-sm">Demo</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title">ExecuteAsync</h6>
                    <p class="card-text small">Automatic error handling</p>
                    <a href="/execute-async-demo" class="btn btn-outline-secondary btn-sm">Demo</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title">Debounce/Throttle</h6>
                    <p class="card-text small">Rate-limited updates</p>
                    <a href="/debounce-demo" class="btn btn-outline-secondary btn-sm">Demo</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <h6 class="card-title">LazyLoad</h6>
                    <p class="card-text small">Cached data loading</p>
                    <a href="/lazy-load-demo" class="btn btn-outline-secondary btn-sm">Demo</a>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mb-4">Advanced Features</h2>

    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title">Optimistic Updates</h5>
                    <p class="card-text small">
                        Update UI immediately, rollback automatically on server error. Perfect for responsive UIs.
                    </p>
                    <a href="/optimistic-demo" class="btn btn-primary btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title">Undo/Redo History</h5>
                    <p class="card-text small">
                        Full history stack for editor-like experiences. Memory-limited with action grouping.
                    </p>
                    <a href="/history-demo" class="btn btn-primary btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-primary">
                <div class="card-body">
                    <h5 class="card-title">Query System</h5>
                    <p class="card-text small">
                        TanStack Query-inspired data fetching with caching, background refresh, and mutations.
                    </p>
                    <a href="/query-demo" class="btn btn-primary btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <h5 class="card-title">Cross-Tab Sync</h5>
                    <p class="card-text small">
                        Real-time state synchronization across browser tabs using BroadcastChannel API.
                    </p>
                    <a href="/tab-sync-demo" class="btn btn-info btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <h5 class="card-title">Immer-Style Updates</h5>
                    <p class="card-text small">
                        Clean syntax for complex nested updates using draft-based mutations.
                    </p>
                    <a href="/immer-demo" class="btn btn-info btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-info">
                <div class="card-body">
                    <h5 class="card-title">Redux-Style Actions</h5>
                    <p class="card-text small">
                        Type-safe action dispatching with pattern matching reducers.
                    </p>
                    <a href="/actions-demo" class="btn btn-info btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-success">
                <div class="card-body">
                    <h5 class="card-title">Plugin System</h5>
                    <p class="card-text small">
                        Extensible hooks for cross-cutting concerns: logging, analytics, validation, and more.
                    </p>
                    <a href="/plugin-demo" class="btn btn-success btn-sm">View Demo</a>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 border-danger">
                <div class="card-body">
                    <h5 class="card-title">Security Features</h5>
                    <p class="card-text small">
                        Sensitive data filtering, state validation, and message signing for secure state management.
                    </p>
                    <a href="/security-demo" class="btn btn-danger btn-sm">View Demo</a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>Learning Path</h5>
                </div>
                <div class="card-body">
                    <h6>Recommended Order:</h6>
                    <ol>
                        <li><strong>Counter</strong> - Basics: state, updates, DevTools</li>
                        <li><strong>Todo List</strong> - Immutable collections</li>
                        <li><strong>Async Helpers</strong> - AsyncData, ExecuteAsync, Debounce, LazyLoad</li>
                        <li><strong>Shopping Cart</strong> - Persistence with LocalStorage</li>
                        <li><strong>Theme Settings</strong> - Selectors for performance</li>
                        <li><strong>Optimistic Updates</strong> - Instant UI with rollback</li>
                        <li><strong>History</strong> - Undo/redo functionality</li>
                        <li><strong>Query System</strong> - Data fetching with caching</li>
                        <li><strong>Advanced</strong> - Tab Sync, Immer, Actions, Plugins, Security</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4 mb-5">
        <div class="col-md-12">
            <div class="card bg-light">
                <div class="card-body text-center">
                    <h5>Ready to build something awesome?</h5>
                    <p class="mb-3">
                        Start with the Counter example and work your way through each demo.
                    </p>
                    <a href="/counter" class="btn btn-lg btn-primary">
                        Start Learning
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
