@page "/execute-async-demo"
@using EasyAppDev.Blazor.Store.Sample.State
@using EasyAppDev.Blazor.Store.AsyncActions
@using EasyAppDev.Blazor.Store.Blazor
@inject ReqResApi Api
@inherits StoreComponentWithUtilities<UserManagementState>

<PageTitle>ExecuteAsync Demo</PageTitle>

<div class="container mt-4">
    <h1>ExecuteAsync Helper Demo</h1>
    <p class="lead">
        Automatic async action handling - reduce 12+ lines of try-catch boilerplate to 5 lines!
    </p>

    <div class="alert alert-success mb-4">
        <strong>Real API!</strong> This demo uses <a href="https://jsonplaceholder.typicode.com" target="_blank" class="alert-link">JSONPlaceholder</a> -
        a free REST API that provides real user data. The ExecuteAsync helper manages loading/error states automatically.
    </div>

    <div class="row mt-4">
        <div class="col-md-8">
            <!-- Load User Section -->
            <div class="card mb-3">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Load User Profile</h5>
                    <div class="btn-group btn-group-sm">
                        @for (int i = 1; i <= 6; i++)
                        {
                            var userId = i;
                            <button class="btn btn-light btn-sm" @onclick="() => LoadUser(userId)" disabled="@State.User.IsLoading">
                                @userId
                            </button>
                        }
                    </div>
                </div>
                <div class="card-body">
                    @if (State.User.IsNotAsked)
                    {
                        <div class="text-center py-3">
                            <p class="text-muted mb-3">Click a number above or "Load User" to fetch a profile from JSONPlaceholder API</p>
                            <svg width="64" height="64" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                            </svg>
                        </div>
                    }
                    else if (State.User.IsLoading)
                    {
                        <div class="d-flex align-items-center py-3">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                            <span>Loading user profile from JSONPlaceholder API...</span>
                        </div>
                    }
                    else if (State.User.HasError)
                    {
                        <div class="alert alert-danger mb-0">
                            <h6 class="alert-heading">Error Loading Profile</h6>
                            <p class="mb-0">@State.User.Error</p>
                        </div>
                    }
                    else if (State.User.HasData)
                    {
                        <div class="user-profile">
                            <div class="d-flex align-items-center mb-3">
                                <img src="@($"https://i.pravatar.cc/64?u={State.User.Data!.Email}")"
                                     alt="@State.User.Data.Name"
                                     class="rounded-circle me-3"
                                     width="64" height="64" />
                                <div>
                                    <h5 class="mb-0">@State.User.Data!.Name</h5>
                                    <small class="text-muted">ID: @State.User.Data.Id</small>
                                </div>
                            </div>
                            <p class="mb-0">
                                <strong>Email:</strong> @State.User.Data.Email
                            </p>
                        </div>
                    }

                    <div class="mt-3">
                        <button class="btn btn-primary" @onclick="() => LoadUser(1)" disabled="@State.User.IsLoading">
                            @if (State.User.IsLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <span>@(State.User.IsLoading ? "Loading..." : "Load User 1")</span>
                        </button>
                        <button class="btn btn-warning ms-2" @onclick="LoadUserWithError" disabled="@State.User.IsLoading">
                            Simulate Error (User 999)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Save User Section -->
            <div class="card mb-3">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Save User Changes</h5>
                </div>
                <div class="card-body">
                    @if (State.IsSaving)
                    {
                        <div class="d-flex align-items-center py-2">
                            <div class="spinner-border spinner-border-sm text-success me-2" role="status">
                                <span class="visually-hidden">Saving...</span>
                            </div>
                            <span>Saving changes to JSONPlaceholder API...</span>
                        </div>
                    }
                    else if (State.SaveSuccess)
                    {
                        <div class="alert alert-success mb-0">
                            Changes saved successfully!
                            <br />
                            <small class="text-muted">Note: JSONPlaceholder simulates save - data isn't persisted on server.</small>
                        </div>
                    }
                    else if (State.SaveError != null)
                    {
                        <div class="alert alert-danger mb-0">
                            <strong>Error:</strong> @State.SaveError
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Click "Save Changes" to persist user data via JSONPlaceholder API</p>
                    }

                    <div class="mt-3">
                        <button class="btn btn-success" @onclick="SaveUser" disabled="@(State.IsSaving || !State.User.HasData)">
                            @if (State.IsSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <span>@(State.IsSaving ? "Saving..." : "Save Changes")</span>
                        </button>
                        <button class="btn btn-outline-danger ms-2" @onclick="SaveUserWithError" disabled="@(State.IsSaving || !State.User.HasData)">
                            Save (Simulate Error)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Delete User Section -->
            <div class="card">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">Delete User</h5>
                </div>
                <div class="card-body">
                    @if (State.IsDeleting)
                    {
                        <div class="d-flex align-items-center py-2">
                            <div class="spinner-border spinner-border-sm text-danger me-2" role="status">
                                <span class="visually-hidden">Deleting...</span>
                            </div>
                            <span>Deleting user via JSONPlaceholder API...</span>
                        </div>
                    }
                    else if (State.DeleteSuccess)
                    {
                        <div class="alert alert-info mb-0">
                            User deleted successfully.
                            <button class="btn btn-link p-0 ms-2" @onclick="Reset">Reset Demo</button>
                        </div>
                    }
                    else if (State.DeleteError != null)
                    {
                        <div class="alert alert-danger mb-0">
                            <strong>Error:</strong> @State.DeleteError
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">Permanently remove the user account</p>
                    }

                    <div class="mt-3">
                        <button class="btn btn-danger" @onclick="DeleteUser" disabled="@(State.IsDeleting || !State.User.HasData)">
                            @if (State.IsDeleting)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            <span>@(State.IsDeleting ? "Deleting..." : "Delete User")</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <!-- Code Example -->
            <div class="card mb-3">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">Code Example</h5>
                </div>
                <div class="card-body p-0">
                    <pre class="mb-0 p-3" style="font-size: 0.8rem; background: #f5f5f5;"><code>// Traditional: 12+ lines with try-catch
async Task LoadUser(int id)
{
  Update(s => s with {
    User = s.User.ToLoading()
  });
  try {
    var user = await Api.GetUserAsync(id);
    Update(s => s with {
      User = AsyncData.Success(user)
    });
  } catch (Exception ex) {
    Update(s => s with {
      User = AsyncData.Failure(ex.Message)
    });
  }
}

// ExecuteAsync: 5 lines!
async Task LoadUser(int id)
{
  await ExecuteAsync(
    () => Api.GetUserAsync(id),
    loading: s => s with {
      User = s.User.ToLoading()
    },
    success: (s, user) => s with {
      User = AsyncData.Success(user)
    }
  );
}</code></pre>
                </div>
                <div class="card-footer">
                    <small class="text-muted">
                        <strong>ExecuteAsync</strong> provides automatic error handling - no try-catch needed!
                    </small>
                </div>
            </div>

            <!-- Benefits -->
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Benefits</h5>
                </div>
                <div class="card-body">
                    <ul class="mb-0" style="font-size: 0.9rem;">
                        <li><strong>Automatic error handling</strong> - No try-catch needed</li>
                        <li><strong>Loading state</strong> - Set automatically</li>
                        <li><strong>Consistent pattern</strong> - Same across all operations</li>
                        <li><strong>Type-safe</strong> - Full compiler support</li>
                        <li><strong>DevTools integration</strong> - Actions tracked</li>
                        <li><strong>Real API ready</strong> - Works with any async call</li>
                    </ul>
                </div>
            </div>

            <!-- State Info -->
            <div class="card mt-3">
                <div class="card-header">
                    <h5 class="mb-0">Current State</h5>
                </div>
                <div class="card-body small">
                    <dl class="mb-0">
                        <dt>User.IsLoading</dt>
                        <dd><span class="badge @(State.User.IsLoading ? "bg-primary" : "bg-secondary")">@State.User.IsLoading</span></dd>
                        <dt>User.HasData</dt>
                        <dd><span class="badge @(State.User.HasData ? "bg-success" : "bg-secondary")">@State.User.HasData</span></dd>
                        <dt>IsSaving</dt>
                        <dd><span class="badge @(State.IsSaving ? "bg-success" : "bg-secondary")">@State.IsSaving</span></dd>
                        <dt>IsDeleting</dt>
                        <dd><span class="badge @(State.IsDeleting ? "bg-danger" : "bg-secondary")">@State.IsDeleting</span></dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    async Task LoadUser(int userId)
    {
        await ExecuteAsync(
            async () =>
            {
                var user = await Api.GetUserAsync(userId);
                if (user == null) throw new Exception($"User {userId} not found");
                return new User(user.Id, user.Name, user.Email);
            },
            loading: s => s with { User = s.User.ToLoading(), SaveSuccess = false, SaveError = null },
            success: (s, user) => s with { User = AsyncData<User>.Success(user) },
            error: (s, ex) => s with { User = AsyncData<User>.Failure(ex.Message) }
        );
    }

    async Task LoadUserWithError()
    {
        await ExecuteAsync(
            async () =>
            {
                // Try to load non-existent user
                var user = await Api.GetUserAsync(999);
                if (user == null) throw new Exception("User 999 not found. Server returned 404 Not Found.");
                return new User(user.Id, user.Name, user.Email);
            },
            loading: s => s with { User = s.User.ToLoading() },
            success: (s, user) => s with { User = AsyncData<User>.Success(user) },
            error: (s, ex) => s with { User = AsyncData<User>.Failure(ex.Message) }
        );
    }

    async Task SaveUser()
    {
        if (!State.User.HasData) return;

        await ExecuteAsync(
            async () =>
            {
                // JSONPlaceholder PATCH endpoint (simulates update)
                using var http = new HttpClient();
                var response = await http.PatchAsync(
                    $"https://jsonplaceholder.typicode.com/users/{State.User.Data!.Id}",
                    new StringContent(
                        System.Text.Json.JsonSerializer.Serialize(new { name = State.User.Data.Name, job = "updated" }),
                        System.Text.Encoding.UTF8,
                        "application/json"));
                response.EnsureSuccessStatusCode();
            },
            loading: s => s with { IsSaving = true, SaveSuccess = false, SaveError = null },
            success: s => s with { IsSaving = false, SaveSuccess = true },
            error: (s, ex) => s with { IsSaving = false, SaveError = ex.Message }
        );
    }

    async Task SaveUserWithError()
    {
        await ExecuteAsync(
            async () =>
            {
                await Task.Delay(500);
                throw new Exception("Failed to save user data. Validation failed: Email already exists.");
            },
            loading: s => s with { IsSaving = true, SaveSuccess = false, SaveError = null },
            success: s => s with { IsSaving = false, SaveSuccess = true },
            error: (s, ex) => s with { IsSaving = false, SaveError = ex.Message }
        );
    }

    async Task DeleteUser()
    {
        if (!State.User.HasData) return;

        await ExecuteAsync(
            async () =>
            {
                // JSONPlaceholder DELETE endpoint (simulates delete)
                using var http = new HttpClient();
                var response = await http.DeleteAsync($"https://jsonplaceholder.typicode.com/users/{State.User.Data!.Id}");
                response.EnsureSuccessStatusCode();
            },
            loading: s => s with { IsDeleting = true, DeleteSuccess = false, DeleteError = null },
            success: s => s with { IsDeleting = false, DeleteSuccess = true, User = AsyncData<User>.NotAsked() },
            error: (s, ex) => s with { IsDeleting = false, DeleteError = ex.Message }
        );
    }

    void Reset()
    {
        Update(s => new UserManagementState(AsyncData<User>.NotAsked()));
    }
}
