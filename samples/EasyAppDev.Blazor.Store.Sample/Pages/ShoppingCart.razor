@page "/cart"
@using EasyAppDev.Blazor.Store.Sample.State
@inherits StoreComponent<ShoppingCartState>

<PageTitle>Shopping Cart</PageTitle>

<div class="container mt-4">
    <h1>🛒 Shopping Cart</h1>
    <p class="lead">Demonstrates <strong>persistence with LocalStorage</strong></p>

    <div class="alert alert-info">
        <h5>💡 What This Demo Shows:</h5>
        <ul class="mb-0">
            <li><strong>Automatic persistence</strong> to browser localStorage</li>
            <li>State survives page refreshes and browser restarts</li>
            <li>Complex nested immutable data structures</li>
            <li>Computed properties (subtotal, total, discounts)</li>
        </ul>
    </div>

    <div class="alert alert-success">
        <strong>🔄 Try it:</strong> Add items to your cart, then refresh the page!
        Your cart will be automatically restored from localStorage.
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Available Products</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var product in ShoppingCartState.SampleProducts)
                        {
                            <div class="col-md-6">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <div class="text-center mb-2" style="font-size: 48px;">
                                            @product.ImageUrl
                                        </div>
                                        <h6 class="card-title">@product.Name</h6>
                                        <p class="card-text text-primary fw-bold">
                                            $@product.Price.ToString("F2")
                                        </p>
                                        <button class="btn btn-primary btn-sm w-100"
                                                @onclick="@(() => Update(s => s.AddItem(product)))">
                                            Add to Cart
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Your Cart (@State.ItemCount items)</h5>
                </div>
                <div class="card-body">
                    @if (!State.Items.Any())
                    {
                        <div class="text-center text-muted py-4">
                            <p>Your cart is empty</p>
                            <small>Add some products to get started!</small>
                        </div>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var item in State.Items)
                            {
                                <div class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <div class="flex-grow-1">
                                            <h6 class="mb-1">@item.Product.Name</h6>
                                            <small class="text-muted">
                                                $@item.Product.Price.ToString("F2") × @item.Quantity
                                            </small>
                                        </div>
                                        <strong>$@item.Total.ToString("F2")</strong>
                                    </div>
                                    <div class="btn-group btn-group-sm mt-2" role="group">
                                        <button class="btn btn-outline-secondary"
                                                @onclick="@(() => Update(s => s.UpdateQuantity(item.Product.Id, item.Quantity - 1)))">
                                            −
                                        </button>
                                        <button class="btn btn-outline-secondary disabled">
                                            @item.Quantity
                                        </button>
                                        <button class="btn btn-outline-secondary"
                                                @onclick="@(() => Update(s => s.UpdateQuantity(item.Product.Id, item.Quantity + 1)))">
                                            +
                                        </button>
                                        <button class="btn btn-outline-danger"
                                                @onclick="@(() => Update(s => s.RemoveItem(item.Product.Id)))">
                                            🗑️
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <hr />

                        <div class="mb-3">
                            <label class="form-label">Discount Code</label>
                            <div class="input-group input-group-sm">
                                <input type="text"
                                       class="form-control"
                                       placeholder="Enter code"
                                       @bind="discountCode" />
                                <button class="btn btn-outline-secondary"
                                        @onclick="ApplyDiscount"
                                        disabled="@string.IsNullOrWhiteSpace(discountCode)">
                                    Apply
                                </button>
                            </div>
                            <small class="text-muted">Try: SAVE10 or SAVE20</small>
                        </div>

                        @if (State.DiscountCode != null)
                        {
                            <div class="alert alert-success alert-sm py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <span>
                                        <strong>@State.DiscountCode</strong> applied
                                        (@State.DiscountPercent% off)
                                    </span>
                                    <button class="btn btn-sm btn-link p-0"
                                            @onclick="@(() => Update(s => s.RemoveDiscount()))">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        }

                        <div class="border-top pt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Subtotal:</span>
                                <strong>$@State.Subtotal.ToString("F2")</strong>
                            </div>
                            @if (State.DiscountAmount > 0)
                            {
                                <div class="d-flex justify-content-between mb-2 text-success">
                                    <span>Discount:</span>
                                    <strong>-$@State.DiscountAmount.ToString("F2")</strong>
                                </div>
                            }
                            <div class="d-flex justify-content-between mb-3">
                                <h5>Total:</h5>
                                <h5 class="text-primary">$@State.Total.ToString("F2")</h5>
                            </div>
                            <button class="btn btn-success w-100 mb-2" disabled>
                                Checkout (Demo)
                            </button>
                            <button class="btn btn-outline-danger btn-sm w-100"
                                    @onclick="@(() => Update(s => s.Clear()))">
                                Clear Cart
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5>📖 Code Example</h5>
        </div>
        <div class="card-body">
            <h6>Store Registration with Persistence:</h6>
            <pre class="bg-light p-3"><code>// Program.cs
builder.Services.AddStore(
    ShoppingCartState.Empty,
    store => store
        .WithPersistence(
            PersistenceType.LocalStorage,
            "shopping-cart")
        .WithDevTools("Shopping Cart")
);</code></pre>

            <h6 class="mt-3">State Definition:</h6>
            <pre class="bg-light p-3"><code>public record ShoppingCartState(
    ImmutableList&lt;CartItem&gt; Items,
    string? DiscountCode = null,
    decimal DiscountPercent = 0)
{
    public ShoppingCartState AddItem(Product product, int quantity = 1)
    {
        var existingIndex = Items.FindIndex(
            item => item.Product.Id == product.Id);

        if (existingIndex >= 0)
        {
            var item = Items[existingIndex];
            var updated = item with { Quantity = item.Quantity + quantity };
            return this with { Items = Items.SetItem(existingIndex, updated) };
        }

        return this with { Items = Items.Add(new CartItem(product, quantity)) };
    }

    // Computed properties
    public decimal Subtotal => Items.Sum(item => item.Total);
    public decimal Total => Subtotal - DiscountAmount;
}</code></pre>

            <h6 class="mt-3">Persistence Options:</h6>
            <pre class="bg-light p-3"><code>// LocalStorage (persists across browser sessions)
.WithPersistence(PersistenceType.LocalStorage, "key")

// SessionStorage (cleared when tab closes)
.WithPersistence(PersistenceType.SessionStorage, "key")</code></pre>

            <h6 class="mt-3">Key Principles:</h6>
            <ul>
                <li>✅ Persistence is automatic - no manual save/load needed</li>
                <li>✅ State is serialized to JSON and saved on every update</li>
                <li>✅ State is restored when the store is initialized</li>
                <li>✅ Works with complex nested immutable structures</li>
                <li>✅ Use LocalStorage for long-term persistence</li>
                <li>✅ Use SessionStorage for temporary session data</li>
            </ul>
        </div>
    </div>
</div>

@code {
    private string discountCode = "";

    private void ApplyDiscount()
    {
        if (string.IsNullOrWhiteSpace(discountCode)) return;

        var code = discountCode.ToUpper().Trim();
        var percent = code switch
        {
            "SAVE10" => 10m,
            "SAVE20" => 20m,
            "SAVE50" => 50m,
            _ => 0m
        };

        if (percent > 0)
        {
            Update(s => s.ApplyDiscount(code, percent));
            discountCode = "";
        }
    }
}
