@page "/history-demo"
@using EasyAppDev.Blazor.Store.History
@inherits StoreComponent<EditorHistoryState>
@inject IStoreHistory<EditorHistoryState> History

<PageTitle>Undo/Redo History</PageTitle>

<div class="container mt-4">
    <h1>Undo/Redo History</h1>
    <p class="lead">
        Full history stack for editor-like experiences with memory management.
    </p>

    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Text Editor</h5>
                    <div class="btn-group">
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="Undo" disabled="@(!History.CanUndo)"
                                title="Undo (Ctrl+Z)">
                            <span>↩ Undo</span>
                        </button>
                        <button class="btn btn-outline-secondary btn-sm"
                                @onclick="Redo" disabled="@(!History.CanRedo)"
                                title="Redo (Ctrl+Y)">
                            <span>↪ Redo</span>
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="btn-toolbar mb-2" role="toolbar">
                            <div class="btn-group me-2">
                                <button class="btn btn-sm @(State.IsBold ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="ToggleBold" title="Bold">
                                    <strong>B</strong>
                                </button>
                                <button class="btn btn-sm @(State.IsItalic ? "btn-primary" : "btn-outline-secondary")"
                                        @onclick="ToggleItalic" title="Italic">
                                    <em>I</em>
                                </button>
                            </div>
                            <div class="btn-group me-2">
                                <select class="form-select form-select-sm" style="width: auto;"
                                        value="@State.FontSize" @onchange="OnFontSizeChange">
                                    <option value="12px">12px</option>
                                    <option value="14px">14px</option>
                                    <option value="16px">16px</option>
                                    <option value="18px">18px</option>
                                    <option value="24px">24px</option>
                                    <option value="32px">32px</option>
                                </select>
                            </div>
                            <div class="btn-group">
                                <input type="color" class="form-control form-control-color"
                                       value="@State.TextColor" @onchange="OnColorChange"
                                       title="Text color" />
                            </div>
                        </div>

                        <textarea class="form-control"
                                  rows="6"
                                  value="@State.Content"
                                  @oninput="OnContentChange"
                                  style="font-size: @State.FontSize; color: @State.TextColor;
                                         font-weight: @(State.IsBold ? "bold" : "normal");
                                         font-style: @(State.IsItalic ? "italic" : "normal");">
                        </textarea>
                    </div>

                    <div class="d-flex justify-content-between">
                        <button class="btn btn-outline-danger btn-sm" @onclick="Reset">
                            Reset to Default
                        </button>
                        <span class="text-muted small">
                            Position: @(History.CurrentIndex + 1) / @History.Count
                        </span>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">History Timeline</h5>
                </div>
                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    @if (History.Entries.Any())
                    {
                        <div class="list-group">
                            @for (int i = 0; i < History.Entries.Count; i++)
                            {
                                var index = i;
                                var entry = History.Entries[i];
                                var isCurrent = i == History.CurrentIndex;
                                <button class="list-group-item list-group-item-action @(isCurrent ? "active" : "")"
                                        @onclick="() => GoTo(index)">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span>
                                            @if (isCurrent)
                                            {
                                                <strong>@(entry.Action ?? "Initial")</strong>
                                            }
                                            else
                                            {
                                                @(entry.Action ?? "Initial")
                                            }
                                        </span>
                                        <small class="@(isCurrent ? "" : "text-muted")">
                                            @entry.Timestamp.ToString("HH:mm:ss")
                                        </small>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center">No history entries yet.</p>
                    }
                </div>
                <div class="card-footer">
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearHistory">
                        Clear History
                    </button>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Current State</h5>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>Content Length</dt>
                        <dd>@State.Content.Length characters</dd>
                        <dt>Font Size</dt>
                        <dd>@State.FontSize</dd>
                        <dt>Text Color</dt>
                        <dd><span class="badge" style="background-color: @State.TextColor">@State.TextColor</span></dd>
                        <dt>Formatting</dt>
                        <dd>@(State.IsBold ? "Bold " : "")@(State.IsItalic ? "Italic" : "")@(!State.IsBold && !State.IsItalic ? "Normal" : "")</dd>
                    </dl>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">How It Works</h5>
                </div>
                <div class="card-body small">
                    <p>Every state change is recorded in history:</p>
                    <ul>
                        <li>Use <strong>Undo/Redo</strong> buttons</li>
                        <li>Click any history entry to jump to that point</li>
                        <li>History is memory-limited</li>
                    </ul>

                    <h6 class="mt-3">Setup:</h6>
                    <pre class="bg-light p-2"><code>builder.Services
  .AddStoreWithHistory(
    EditorState.Initial,
    opts => opts
      .WithMaxSize(100)
      .ExcludeActions("CURSOR")
  );</code></pre>

                    <h6 class="mt-3">Usage:</h6>
                    <pre class="bg-light p-2"><code>@@inject IStoreHistory&lt;T&gt; History

await History.UndoAsync();
await History.RedoAsync();
await History.GoToAsync(5);</code></pre>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        History.OnHistoryChanged += OnHistoryChanged;
    }

    private void OnHistoryChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task OnContentChange(ChangeEventArgs e)
    {
        await Update(s => s.SetContent(e.Value?.ToString() ?? ""), "SET_CONTENT");
    }

    private async Task ToggleBold()
    {
        await Update(s => s.ToggleBold(), "TOGGLE_BOLD");
    }

    private async Task ToggleItalic()
    {
        await Update(s => s.ToggleItalic(), "TOGGLE_ITALIC");
    }

    private async Task OnFontSizeChange(ChangeEventArgs e)
    {
        await Update(s => s.SetFontSize(e.Value?.ToString() ?? "16px"), "SET_FONT_SIZE");
    }

    private async Task OnColorChange(ChangeEventArgs e)
    {
        await Update(s => s.SetTextColor(e.Value?.ToString() ?? "#000000"), "SET_COLOR");
    }

    private async Task Reset()
    {
        await Update(s => s.Reset(), "RESET");
    }

    private async Task Undo()
    {
        await History.UndoAsync();
    }

    private async Task Redo()
    {
        await History.RedoAsync();
    }

    private async Task GoTo(int index)
    {
        await History.GoToAsync(index);
    }

    private void ClearHistory()
    {
        History.Clear();
    }

    public new void Dispose()
    {
        History.OnHistoryChanged -= OnHistoryChanged;
        base.Dispose();
    }
}
