<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.0-preview.1.25120.3" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.0-preview.1.25120.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EasyAppDev.Blazor.Store\EasyAppDev.Blazor.Store.csproj" />
  </ItemGroup>

  <!-- Exclude diagnostics page in Release builds (diagnostics is DEBUG-only) -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Content Remove="Pages/Diagnostics.razor" />
    <Compile Remove="Pages/Diagnostics.razor" />
  </ItemGroup>

</Project>
